# Private server variables. Never prefix the API key with VITE_.
THE_ODDS_API_KEY=
# Separate provider; manual discovery only, never used automatically during build.
ODDSPAPI_API_KEY=
# The existing Vercel Secret named oddsapi is accepted as a server-only alias.
SUPABASE_URL=
# Preferred key supplied by the native Vercel integration (never service-role).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Optional additional restriction. Database membership is always required.
ALLOWED_USER_IDS=
# Production-only opt-in for the reviewed migration runner; keep off in previews.
APP_DATABASE_SETUP=
# Owner email reservation only. No password or invitation is generated or sent.
APP_OWNER_EMAIL=
# Publishable browser configuration (these are not secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Native integration SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY and NEXT_PUBLIC_*
# publishable aliases are mapped to the browser only after key validation.
